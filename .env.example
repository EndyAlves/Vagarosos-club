# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API). Sem estas variáveis o site roda em modo demonstração.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: endereço final do site, se usar domínio próprio (para a prévia no WhatsApp)
# VITE_SITE_URL=https://vagarosos.club
